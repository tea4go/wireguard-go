# WireGuard 客户端安装配置模板
# 用法：复制本文件为 .env，填入真实值；.env 已被 .gitignore 忽略，切勿提交。

# 服务器公钥（WireGuard 服务器 [Interface] 的 PublicKey）
SERVER_PUBLIC_KEY=

# 服务器端点（IP:端口）
SERVER_ENDPOINT=

# 客户端隧道地址（服务器侧需登记为 allowed-ips）
CLIENT_ADDRESS=192.168.190.22/32

# 分流隧道路由网段
ALLOWED_IPS=192.168.190.0/24

# 保活间隔（秒）
KEEPALIVE=25

# MTU
MTU=1420
